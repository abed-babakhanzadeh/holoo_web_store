# الگوی تنظیمات محلی. کپی کنید به `.env` (در گیت نیست) و مقدارها را پر کنید. این فایل هرگز نباید رمز واقعی داشته باشد.
# اولویت مقدارها: متغیر محیطی پروسه  >  فایل .env  >  نام‌های قدیمی config/settings.py  (توضیح: holoo/conf.py)

# --- وب‌سرویس هلو (TncHoloo) ---
# آدرس تا /TncHoloo/api (بدون اسلش پایانی). نمونه: http://192.168.1.2:8080/TncHoloo/api
HOLOO_API_URL=
HOLOO_USERNAME=
# رمز کاربر وب‌سرویس به‌صورت base64 (دقیقاً همان مقداری که در Swagger/لاگین وارد می‌کنید)
HOLOO_PASSWORD=
# نام دیتابیس هلو. فعلاً فقط دیتابیس آزمایشی: Holoo2
HOLOO_DB_NAME=Holoo2
# هدر Authorization دلخواه فقط برای /Login (در صورت نیاز)
HOLOO_LOGIN_AUTH_HEADER=123
# مهلت هر درخواست (ثانیه)
HOLOO_TIMEOUT=30

# --- پرچم‌های ایمنی ---
# خواندن: real = تماس واقعی با هلو | mock = داده‌ی ساختگی
HOLOO_READ_MODE=real
# نوشتن (ثبت مشتری و فاکتور):
#   mock     = شبیه‌سازی محلی، هیچ تماسی با هلو (پیش‌فرض)
#   disabled = هیچ تماس و هیچ تسکی
#   real     = ثبت واقعی. فقط وقتی کار می‌کند که HOLOO_DB_NAME در HOLOO_WRITE_ALLOWED_DBS باشد؛ وگرنه خودکار disabled می‌شود.
# ثبت فاکتور در هر حالت فقط پس از «تأیید سفارش» توسط مدیر در پنل ادمین انجام می‌شود.
HOLOO_WRITE_MODE=mock
# فهرست سفید دیتابیس‌هایی که نوشتن واقعی در آن‌ها مجاز است (جداشده با ویرگول). پیش‌فرض فقط Holoo2.
# برای دیتابیس عملیاتی باید نامش را عمداً این‌جا اضافه کنید.
HOLOO_WRITE_ALLOWED_DBS=Holoo2
# پیشوند id سمت کلاینت در هلو (یکتا در کل دیتابیس هلو). برای سایت‌های توسعه/تست که شماره‌ی سفارش/کاربرشان با
# سایت اصلی (یا با مشتری/فاکتورهای تستِ همان دیتابیس هلو) برخورد می‌کند مقدار بدهید. فقط رقم! (هلو id را عددی
# می‌پذیرد؛ حروف و خط‌تیره خطای ۵۱ می‌دهد). مثلاً 8800 ← کاربر ۱ می‌شود 88001. برای سایت اصلی خالی بماند.
HOLOO_CLIENT_ID_PREFIX=
